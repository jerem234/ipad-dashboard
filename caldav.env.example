# iCloud calendar sign-in for the dashboard's calendar container.
# On the server this lives at /DATA/AppData/ipad-dashboard-private/caldav.env
# (outside the web folder, so the iPad page can never serve it).
# Changes are picked up within a minute; no restart needed.

# Your Apple ID email
CALDAV_USER=

# An app-specific password from account.apple.com (Sign-In and Security),
# NOT your Apple ID password. You can revoke it there at any time.
CALDAV_PASSWORD=

# Optional: only show these calendars (comma-separated names). Blank = all.
CALENDARS=
